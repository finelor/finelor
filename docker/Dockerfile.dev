# syntax=docker/dockerfile:1.7

FROM lukemathwalker/cargo-chef:latest-rust-1.95.0 AS chef
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32-unknown-unknown
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) LEPTOS_TRIPLE=x86_64-unknown-linux-gnu; WASM_TRIPLE=x86_64-unknown-linux-musl ;; \
      arm64) LEPTOS_TRIPLE=aarch64-unknown-linux-gnu; WASM_TRIPLE=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    LEPTOS_VERSION=v0.3.6; \
    WASM_BINDGEN_VERSION=0.2.122; \
    curl --fail --show-error --location \
      --output "/tmp/cargo-leptos-${LEPTOS_TRIPLE}.tar.gz" \
      "https://github.com/leptos-rs/cargo-leptos/releases/download/${LEPTOS_VERSION}/cargo-leptos-${LEPTOS_TRIPLE}.tar.gz"; \
    curl --fail --show-error --location \
      --output "/tmp/cargo-leptos-${LEPTOS_TRIPLE}.tar.gz.sha256" \
      "https://github.com/leptos-rs/cargo-leptos/releases/download/${LEPTOS_VERSION}/cargo-leptos-${LEPTOS_TRIPLE}.tar.gz.sha256"; \
    cd /tmp; \
    sha256sum --check "cargo-leptos-${LEPTOS_TRIPLE}.tar.gz.sha256"; \
    tar -xzf "cargo-leptos-${LEPTOS_TRIPLE}.tar.gz"; \
    install -m 0755 "cargo-leptos-${LEPTOS_TRIPLE}/cargo-leptos" /usr/local/bin/cargo-leptos; \
    rm -rf /tmp/cargo-leptos*; \
    curl --fail --show-error --location \
      --output "/tmp/wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz" \
      "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/${WASM_BINDGEN_VERSION}/wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz"; \
    curl --fail --show-error --location \
      --output "/tmp/wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz.sha256sum" \
      "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/${WASM_BINDGEN_VERSION}/wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz.sha256sum"; \
    printf "%s  %s\n" "$(cut -d ' ' -f 1 "wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz.sha256sum")" "wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz" | sha256sum --check -; \
    tar -xzf "wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}.tar.gz"; \
    install -m 0755 "wasm-bindgen-${WASM_BINDGEN_VERSION}-${WASM_TRIPLE}/wasm-bindgen" /usr/local/bin/wasm-bindgen; \
    rm -rf /tmp/wasm-bindgen*

FROM chef AS planner
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY assets ./assets
COPY public ./public
COPY style ./style
COPY migrations ./migrations
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo chef cook --recipe-path recipe.json

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY assets ./assets
COPY public ./public
COPY style ./style
COPY migrations ./migrations
ENV SQLX_OFFLINE=true
ENV LEPTOS_TAILWIND_VERSION=v4.2.1
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/root/.cache/cargo-leptos \
    cargo leptos build

FROM debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/debug/finelor /usr/local/bin/finelor
COPY --from=builder /app/target/site ./target/site
COPY migrations ./migrations
COPY assets ./assets
COPY config.yaml ./config.yaml

CMD ["finelor"]
